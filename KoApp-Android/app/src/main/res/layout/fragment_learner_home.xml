<?xml version="1.0" encoding="utf-8"?>
<!-- 학습자의 홈 화면 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="homeViewModel"
            type="com.dagachi.koapp_android.viewmodel.learner.home.LearnerHomeViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/Main_10"
        android:orientation="vertical"
        tools:context=".view.main.learner.home.LearnerHomeFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_radius_24"
            android:paddingStart="16dp"
            android:elevation="16dp"
            android:outlineSpotShadowColor="#66828282">

            <!-- 프로필 버튼 -->
            <ImageButton
                android:id="@+id/iBtn_learner_home_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="profile"
                android:src="@drawable/ic_profile_24"
                android:background="@color/Transparent"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText"/>

            <!-- 사용자 이름 -->
            <TextView
                android:id="@+id/tv_learner_home_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Korean_H1"
                android:textColor="@color/Black"
                tools:text="윤지님,"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/iBtn_learner_home_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tv_learner_home_top_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:textSize="20sp"
                android:textColor="@color/Gray_700"
                android:text="오늘의 학습을 시작해 봐요!"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_learner_home_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText" />

            <!-- 오늘의 어휘 박스 -->
            <LinearLayout
                android:id="@+id/lLayout_learner_home_today_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/all_radius_16_box"
                android:backgroundTint="@color/Main_20"
                android:paddingTop="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/tv_learner_home_top_comment"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:ignore="UseCompoundDrawables">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오늘의 어휘"
                        style="@style/Korean_Body1"
                        android:textColor="@color/Gray_600"
                        tools:ignore="HardcodedText" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_right_24"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_learner_home_today_word"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Korean_H3"
                    android:text="@{homeViewModel.learnerHomeResponse.todayWord}"
                    android:textColor="@color/Main_100"
                    tools:text="강아지"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- 캐릭터 -->
            <ImageView
                android:layout_width="123dp"
                android:layout_height="115dp"
                android:importantForAccessibility="no"
                android:src="@drawable/koala_leaf"
                android:scaleType="fitCenter"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="-4dp"
                android:layout_marginBottom="49dp"
                app:layout_constraintTop_toBottomOf="@id/iBtn_learner_home_profile"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이번주 출석률"
                    style="@style/Korean_H4"
                    android:textColor="@color/Black"
                    android:layout_marginTop="40dp"
                    android:layout_marginStart="16dp"
                    tools:ignore="HardcodedText" />

                <!-- 이번주 출석률 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_learner_home_attendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    tools:listitem="@layout/item_learner_attendance"
                    tools:itemCount="7"
                    app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘의 미션"
                    style="@style/Korean_H4"
                    android:textColor="@color/Black"
                    android:layout_marginTop="40dp"
                    android:layout_marginStart="16dp"
                    tools:ignore="HardcodedText" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_learner_home_mission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:spanCount="2"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_learner_mission"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="참여 중인 프로그램"
                        style="@style/Korean_H4"
                        android:textColor="@color/Black"
                        tools:ignore="HardcodedText" />
                    
                    <ImageButton
                        android:id="@+id/iBtn_learner_home_program"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="프로그램 추가하기"
                        android:src="@drawable/ic_add_circle_24"
                        android:background="@color/Transparent"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_learner_home_program"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="16dp"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_learner_program"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>